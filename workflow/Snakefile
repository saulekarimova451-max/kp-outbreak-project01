# Project 01: K. pneumoniae outbreak investigation
#
# Run everything:              snakemake --sdm conda --cores 8
# Run only Illumina QC:        snakemake --sdm conda --cores 8 qc_illumina
# Run only Nanopore QC:        snakemake --sdm conda --cores 8 qc_ont
# Run mapping, SNPs and tree:  snakemake --sdm conda --cores 8 snps
# Tables and figures:          snakemake --sdm conda --cores 8 figures
# Nanopore analysis:           snakemake --sdm conda --cores 8 ont
# Resistance genes (BLAST):    snakemake --sdm conda --cores 8 amr
# Accuracy test (simulated):   snakemake --sdm conda --cores 8 validate
# Runtime table (run last):    snakemake --sdm conda --cores 8 runtime
# Quick test on tiny data:     snakemake --sdm conda --cores 2 test --configfile config/test.yaml
# See what would run (no run): snakemake -n
#
# Inputs : config/config.yaml (thresholds), config/samples.tsv (one row per isolate),
#          reads in data/raw/ (downloaded by scripts/fetch_reads.py)
# Outputs: results/   (not committed; rebuilt by this workflow)

import pandas as pd

configfile: "config/config.yaml"

SAMPLES = (
    pd.read_csv(config.get("samples", "config/samples.tsv"), sep="\t", dtype=str)
    .set_index("isolate", drop=False)
)
ISOLATES = list(SAMPLES.index)
RAW = config.get("raw_dir", "data/raw")
THREADS = int(config["resources"]["threads"])

wildcard_constraints:
    isolate="|".join(ISOLATES),


def illumina_reads(wc):
    run = SAMPLES.loc[wc.isolate, "illumina_run"]
    return {"r1": f"{RAW}/{run}_1.fastq.gz", "r2": f"{RAW}/{run}_2.fastq.gz"}


RAW_ILLUMINA = [
    f"{RAW}/{SAMPLES.loc[i, 'illumina_run']}_{m}.fastq.gz" for i in ISOLATES for m in (1, 2)
]


def ont_reads(wc):
    run = SAMPLES.loc[wc.isolate, "ont_run"]
    return f"{RAW}/{run}_1.fastq.gz"


# ---- targets -------------------------------------------------------------
QC_ILLUMINA = [
    "results/qc/multiqc_report.html",
    "results/qc/seqkit_illumina.tsv",
]
QC_ONT = expand("results/qc/nanoplot/{isolate}/NanoStats.txt", isolate=ISOLATES)
SNPS = [
    "results/core/snp_matrix_raw.tsv",
    "results/core/snp_matrix_clean.tsv",
    "results/core/core.txt",
    "results/tree/outbreak.treefile",
] + expand("results/coverage/{isolate}.mosdepth.summary.txt", isolate=ISOLATES)
ONT = [
    "report/tables/illumina_vs_nanopore.tsv",
    "report/figures/illumina_vs_nanopore.png",
    "report/tables/snp_matrix_nanopore.tsv",
    "report/tables/nanopore_only_snp_profile.tsv",
    "report/figures/illumina_vs_nanopore_distances.png",
] + expand("results/ont/flye/{isolate}/assembly_info.txt", isolate=config["ont"]["assemble"])
AMR = [
    "report/tables/amr_genes.tsv",
    "report/tables/antibiogram_predicted.tsv",
    "report/tables/amr_vs_ncbi.tsv",
    "report/figures/amr_genes.png",
]
VALIDATE = ["report/tables/validation_snippy.tsv"]
RUNTIME = ["report/tables/runtime.tsv", "report/figures/runtime.png"]
FIGURES = [
    "report/tables/snp_pairs.tsv",
    "report/tables/clusters.tsv",
    "report/figures/snp_heatmap.png",
    "report/figures/timeline.png",
    "report/figures/tree.png",
]


rule all:
    input:
        QC_ILLUMINA,
        QC_ONT,
        SNPS,
        ONT,
        AMR,
        FIGURES,
        VALIDATE,
        RUNTIME,


rule qc_illumina:
    input:
        QC_ILLUMINA,


rule qc_ont:
    input:
        QC_ONT,


rule snps:
    input:
        SNPS,


rule ont:
    input:
        ONT,


rule amr:
    input:
        AMR,


rule figures:
    input:
        FIGURES,


rule validate:
    input:
        VALIDATE,


rule runtime:
    input:
        RUNTIME,


rule test:
    """Small end-to-end check on test/ data: QC, Illumina and Nanopore variant calls for 2 isolates."""
    input:
        "results/qc/multiqc_report.html",
        expand("results/snippy/{isolate}/snps.vcf", isolate=ISOLATES),
        expand("results/ont/clair3/{isolate}/merge_output.vcf.gz", isolate=ISOLATES),


include: "rules/qc.smk"
include: "rules/map.smk"
include: "rules/report.smk"
include: "rules/ont.smk"
include: "rules/amr.smk"
include: "rules/validate.smk"
